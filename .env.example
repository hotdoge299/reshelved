# Copy to .env for local dev. On Railway, set these as service variables instead.

# Generate with: openssl rand -hex 32
JWT_SECRET=

# Generate with: node generate-hash.js "your-real-passcode"
ADMIN_PASSWORD_HASH=

PORT=3000

# Where the SQLite file lives. On Railway, point this at your attached volume's mount path.
DB_PATH=./data.db

# Your Netlify site URL(s), comma-separated if you have a preview + prod domain.
FRONTEND_ORIGIN=https://your-site.netlify.app

NODE_ENV=production
